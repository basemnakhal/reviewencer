# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Direct Postgres URL used by `npm run db:push` (Supabase → Project Settings → Database → Connection string)
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---- Anthropic (required for AI chat, summaries, moderation) ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- OpenAI (for Whisper transcription + embeddings) ----
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ---- Video storage (choose one) ----
# Option A: Supabase Storage bucket (default, simplest)
SUPABASE_VIDEO_BUCKET=reviews
# Option B: Mux (better for scale)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ---- App ----
# Public URL used for share cards, OG images, etc.
NEXT_PUBLIC_APP_URL=https://reviewencer.ai

# ---- Moderation ----
# Email address that gets notified when a review is flagged for manual review
MODERATION_NOTIFY_EMAIL=legal@reviewencer.ai
# If true, all reviews go through manual review regardless of AI verdict
MODERATION_STRICT_MODE=false
